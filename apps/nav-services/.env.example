# 服务端口
PORT=3000

# 数据库（沿用旧库，表结构不变）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=jgnav

# JWT 密钥（生产环境必须配置强随机串）
JWT_SECRET=

# 允许的前端来源（逗号分隔）
CORS_ORIGIN=http://localhost:5173

# 生产环境设为 production（Swagger 自动关闭、Cookie 加 secure）
NODE_ENV=development

# 可选：Nest 直挂 HTTPS 证书（nginx 反代场景无需配置）
# SSL_KEY=ssl/heartbright.top.key
# SSL_CERT=ssl/heartbright.top.pem
